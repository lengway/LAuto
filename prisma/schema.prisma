generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportJobStatus {
  pending
  processing
  completed
  failed
}

enum ImportStage {
  raw
  parsed
  normalized
  validated
  imported
  failed
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars      Car[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  parts     Part[]

  @@index([parentId])
  @@index([slug])
}

model Car {
  id           String              @id @default(cuid())
  brandId      String
  model        String
  slug         String
  generation   String?
  years        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  compatParts  PartCompatibility[]
  vinPatterns  VinPattern[]

  @@index([brandId])
  @@unique([brandId, slug])
}

model Part {
  id             String              @id @default(cuid())
  oemNumber      String?
  slug           String              @unique
  title          String
  categoryId     String
  side           String?
  position       String?
  description    String?
  priceFrom      Decimal?            @db.Decimal(10, 2)
  isVisible      Boolean             @default(true)
  inStock        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  compatibilities PartCompatibility[]
  images         Image[]

  @@index([categoryId])
  @@index([oemNumber])
  @@index([title])
}

model PartCompatibility {
  id        String   @id @default(cuid())
  partId     String
  carId      String

  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([partId, carId])
  @@index([carId])
  @@index([partId])
}

model Image {
  id        String   @id @default(cuid())
  partId     String
  url       String
  alt       String?
  sortOrder Int      @default(0)

  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, sortOrder])
  @@index([partId])
}

model VinPattern {
  id        String   @id @default(cuid())
  pattern   String
  carId     String

  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([pattern])
}

model ImportJob {
  id        String          @id @default(cuid())
  file      String
  status    ImportJobStatus @default(pending)
  summary   Json?
  rowsTotal Int?
  rowsSuccess Int?
  rowsFailed Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  rawRows   RawImportRow[]
}

model RawImportRow {
  id          String      @id @default(cuid())
  jobId       String
  line        Int
  article     String?
  oem         String?
  name        String?
  brand       String?
  price       String?
  rawJson     Json?
  stage       ImportStage @default(raw)
  createdAt   DateTime    @default(now())

  job         ImportJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, line])
  @@index([jobId, stage])
}

model ModelAlias {
  id        String   @id @default(cuid())
  alias     String   @unique
  brand     String
  model     String
  createdAt DateTime @default(now())

  @@index([alias])
}
