generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  description String?
  imageUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models    Model[]
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  parts     Part[]
  partLinks PartCategory[]

  @@index([parentId])
  @@index([slug])
}

model Model {
  id           String              @id @default(cuid())
  brandId      String
  model        String
  slug         String
  description  String?
  imageUrl     String?
  generation   String?
  years        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  compatParts  PartFitment[]

  @@index([brandId])
  @@unique([brandId, slug])
}

model Part {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  categoryId     String
  side           String?
  position       String?
  description    String?
  priceFrom      Decimal?            @db.Decimal(10, 2)
  isVisible      Boolean             @default(true)
  inStock        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  compatibilities PartFitment[]
  partCategories PartCategory[]
  images         Image[]

  @@index([categoryId])
  @@index([title])
}

model PartCategory {
  id         String   @id @default(cuid())
  partId     String
  categoryId String

  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([partId, categoryId])
  @@index([partId])
  @@index([categoryId])
}

model PartFitment {
  id        String   @id @default(cuid())
  partId     String
  modelId    String @map("carId")

  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  car        Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([partId, modelId])
  @@index([modelId])
  @@index([partId])
}

model Image {
  id        String   @id @default(cuid())
  partId     String
  url       String
  alt       String?
  sortOrder Int      @default(0)

  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, sortOrder])
  @@index([partId])
}

model SiteSettings {
  id                 String         @id @default(cuid())
  singletonKey       String         @unique @default("main")
  orderWhatsAppPhone String
  mapIframeHtml      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  contactPhones      ContactPhone[]
}

model ContactPhone {
  id          String       @id @default(cuid())
  settingsId  String
  phone       String
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  settings    SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId])
  @@index([sortOrder])
}
